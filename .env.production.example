# Production environment — Render web service + Supabase.
# Values marked SECRET are entered in the Render dashboard, never committed.
# render.yaml already declares the non-secret keys; this file is the checklist.

APP_NAME=CashIko
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                    # SECRET — php artisan key:generate --show
APP_URL=https://cashiko.onrender.com        # your Render URL or custom domain
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning
PORT=8080

# ── Supabase Postgres ────────────────────────────────────────────────
# In the Supabase dashboard: click Connect in the project top bar, choose
# Session pooler. Do NOT compose the host yourself — the pooler index
# (aws-0, aws-1, …) is not derived from the region, so copy the string.
# Username must be postgres.<project-ref>; without the suffix Supabase
# answers "Tenant or user not found". URL-encode @ : / ? # % in the password.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres   # SECRET
DB_SSLMODE=require

# ── Supabase Storage (S3 protocol) ───────────────────────────────────
# Dashboard → Storage → S3 access keys. Bucket must be private.
PRIVATE_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=                          # SECRET
AWS_SECRET_ACCESS_KEY=                     # SECRET
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=cashiko-private
AWS_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Shared state ─────────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# ── AI assistant ─────────────────────────────────────────────────────
GEMINI_API_KEY=                             # SECRET
GEMINI_MODEL=gemini-1.5-flash
